VITE_DATA_PROVIDER=mock
# For production, set to helius/alchemy and provide keys:
# VITE_HELIUS_API_KEY=
# VITE_ALCHEMY_API_KEY=
# VITE_BIRDEYE_API_KEY=
# VITE_GURU_TOKEN_ADDRESS=
# PumpPortal free feed (no key needed for new-token + migration streams):
# VITE_PUMPPORTAL_WS=wss://pumpportal.fun/api/data
# Solana RPC for balances + broadcasting trade-local transactions:
# VITE_SOLANA_RPC=https://api.mainnet-beta.solana.com
# Twitter API v2 Bearer Token (Essential/Elevated access) for Social Monitor:
# VITE_TWITTER_BEARER_TOKEN=
# Discord webhook URL for GURU Monitor alerts:
# VITE_DISCORD_WEBHOOK_URL=
# Twilio SMS credentials for GURU notifications:
# VITE_TWILIO_ACCOUNT_SID=
# VITE_TWILIO_AUTH_TOKEN=
# VITE_TWILIO_FROM_NUMBER=
